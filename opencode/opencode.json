{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": false,
      "headers": {
        "X-Goog-Api-Key": "{env:STITCH_API_KEY}"
      }
    },
    "io.vista/atlassian-mcp": {
      "type": "remote",
      "enabled": false,
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "io.vista/cortex-mcp": {
      "type": "remote",
      "enabled": false,
      "url": "https://mcp.cortex.io/mcp",
      "headers": {
        "Authorization": "Bearer {env:CORTEX_API_TOKEN}"
      }
    },
    "io.vista/figma-mcp": {
      "type": "remote",
      "enabled": false,
      "url": "https://mcp.figma.com/mcp"
    },
    "io.vista/gitlab-mcp": {
      "type": "remote",
      "enabled": true,
      "url": "https://gitlab.com/api/v4/mcp"
    },
    "io.vista/miro-mcp": {
      "type": "remote",
      "enabled": false,
      "url": "https://mcp.miro.com/"
    },
    "io.vista/newrelic-mcp": {
      "type": "remote",
      "enabled": false,
      "url": "https://mcp.newrelic.com/mcp/"
    },
    "io.vista/snowflake-mcp": {
      "type": "remote",
      "enabled": false,
      "url": "https://snowflake-mcp.prod.aws-vista-data-platform.vpsvc.com/mcp"
    },
    "io.vista/ubik-docs-mcp": {
      "type": "remote",
      "enabled": false,
      "url": "https://ubik-docs-mcp.ai-platform.vista.io/mcp"
    },
    "swancp": {
      "type": "local",
      "enabled": false,
      "command": ["npx", "@vp/swancp-poc@latest"]
    },
    
    
    "servers": {
      "skylight": {
        // The hosted Skylight server on the Synology NAS
        // (github.com/ericmasiello/skylight-mcp-nas): one shared Skylight
        // sign-in for every client, admin tools blocked server-side, and
        // MCP_CONFIRM_ELICITATION=off set on the server, so OpenCode's
        // elicitation bug (anomalyco/opencode#51856) can't hang confirm-gated
        // calls. No local Skylight credentials needed: OpenCode signs in with
        // GitHub through the server's auth proxy (/mcps → skylight).
        "type": "remote",
        "url": "https://skylight.tail1057f2.ts.net/mcp",
        // Off by default for every project on this machine (this is also
        // ~/.config/opencode/opencode.json via symlink, per ADR-0003). The
        // ericmasiello-skills project overrides this back on in its own
        // root-level opencode.json, since that's the one place the
        // Skylight-dependent skills actually live.
        "disabled": true
      },
      "n8n": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@nextoolsolutions/mcp-n8n"
        ],
        "environment": {
          "N8N_BASE_URL": "https://automation.vista.io",
          "N8N_API_KEY": "{env:N8N_API_KEY}"
        },
        "enabled": false
      },
      "slack": {
        "type": "remote",
        "url": "https://gateway.ai-platform-sandbox.vista.io/gateways/slack/mcp",
        "disabled": false
      }
    }
  },
  "permission": {
    "external_directory": {
      "~/Sites/**": "allow",
      // ~/.agents is a symlink farm into ~/Sites/ericmasiello-skills; permission
      // matching checks the path as given, before resolving symlinks, so this
      // needs its own entry even though its targets already live under ~/Sites.
      "~/.agents/**": "allow",
      // Home-level OpenCode state (e.g. the `plan` agent's scratch files),
      // distinct from ~/.config/opencode below.
      "~/.opencode/**": "allow",
      "~/.local/share/opencode/worktree/**": "allow",
      "~/.config/opencode/**": "allow",
      // Work Laptop only: twg writes each run's output to a freshly randomized
      // folder under this machine's TMPDIR, so this hash won't resolve on other machines.
      "/var/folders/08/btbwrfxn3tl4vsqsvv2z46j00000gp/T/twg/**": "allow",
      "/private/var/folders/08/btbwrfxn3tl4vsqsvv2z46j00000gp/T/twg/**": "allow"
    },
    "edit": {
      "~/Sites/**": "allow",
      "~/.agents/**": "allow",
      "~/.opencode/**": "allow",
      "~/.local/share/opencode/worktree/**": "allow",
      "~/.config/opencode/**": "allow"
    }
  },
  "plugins": [
    "@openchamber/opencode-claude@1.7.0"
  ]
}
