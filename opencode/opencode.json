{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"io.vista/atlassian-mcp": {
			"type": "remote",
			"enabled": false,
			"url": "https://mcp.atlassian.com/v1/mcp"
		},
		"io.vista/cortex-mcp": {
			"type": "remote",
			"url": "https://mcp.cortex.io/mcp",
			"enabled": true,
			"oauth": false,
			"headers": {
				"Authorization": "Bearer {env:CORTEX_API_TOKEN}"
			}
		},
		"io.vista/figma-mcp": {
			"type": "remote",
			"url": "https://mcp.figma.com/mcp",
			"enabled": false
		},
		"io.vista/gitlab-mcp": {
			"type": "remote",
			"url": "https://gitlab.com/api/v4/mcp",
			"enabled": true
		},
		"io.vista/miro-mcp": {
			"type": "remote",
			"url": "https://mcp.miro.com/",
			"enabled": false
		},
		"io.vista/newrelic-mcp": {
			"type": "remote",
			"url": "https://mcp.newrelic.com/mcp/",
			"enabled": false
		},
		"io.vista/snowflake-mcp": {
			"type": "remote",
			"url": "https://snowflake-mcp.prod.aws-vista-data-platform.vpsvc.com/mcp",
			"enabled": false
		},
		"io.vista/ubik-docs-mcp": {
			"type": "remote",
			"url": "https://ubik-docs-mcp.ai-platform.vista.io/mcp",
			"enabled": false
		},
		"skylight": {
			"command": [
				"npx",
				"-y",
				"skylight-mcp"
			],
			"enabled": true,
			"type": "local"
		},
		"stitch": {
			"type": "remote",
			"url": "https://stitch.googleapis.com/mcp",
			"enabled": false,
			"headers": {
				"X-Goog-Api-Key": "{env:STITCH_API_KEY}"
			}
		},
		"swancp": {
			"type": "local",
			"enabled": false,
			"command": [
				"npx",
				"@vp/swancp-poc@latest"
			]
		}
	},
	"plugin": [
		"oh-my-openagent@latest",
		"@warp-dot-dev/opencode-warp"
	],
	"share": "disabled"
}