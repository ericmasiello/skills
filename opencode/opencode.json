{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": false,
      "headers": {
        "X-Goog-Api-Key": "{env:STITCH_API_KEY}"
      }
    },
    "io.vista/atlassian-mcp": {
      "type": "remote",
      "enabled": false,
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "io.vista/cortex-mcp": {
      "type": "remote",
      "enabled": false,
      "url": "https://mcp.cortex.io/mcp",
      "headers": {
        "Authorization": "Bearer {env:CORTEX_API_TOKEN}"
      }
    },
    "io.vista/figma-mcp": {
      "type": "remote",
      "enabled": false,
      "url": "https://mcp.figma.com/mcp"
    },
    "io.vista/gitlab-mcp": {
      "type": "remote",
      "enabled": true,
      "url": "https://gitlab.com/api/v4/mcp"
    },
    "io.vista/miro-mcp": {
      "type": "remote",
      "enabled": false,
      "url": "https://mcp.miro.com/"
    },
    "io.vista/newrelic-mcp": {
      "type": "remote",
      "enabled": false,
      "url": "https://mcp.newrelic.com/mcp/"
    },
    "io.vista/snowflake-mcp": {
      "type": "remote",
      "enabled": false,
      "url": "https://snowflake-mcp.prod.aws-vista-data-platform.vpsvc.com/mcp"
    },
    "io.vista/ubik-docs-mcp": {
      "type": "remote",
      "enabled": false,
      "url": "https://ubik-docs-mcp.ai-platform.vista.io/mcp"
    },
    "swancp": {
      "type": "local",
      "enabled": false,
      "command": ["npx", "@vp/swancp-poc@latest"]
    },
    "skylight": {
      "command": ["npx", "-y", "skylight-mcp"],
      "enabled": false,
      "type": "local",
      "environment": {
        // Works around an OpenCode bug, not a skylight-mcp one: OpenCode's
        // MCP client advertises elicitation.form support during the
        // handshake, but never answers an elicitation/create request back
        // (the form is created for session "global" instead of the calling
        // session, so no prompt ever renders). Any confirm-gated skylight
        // tool (skylight_clear_list, bulk deletes, uploads, invites, etc.)
        // then hangs until some outer timeout kills the call — ~600s via
        // Code Mode. skylight-mcp's own confirm-write helper
        // (@chrischall/mcp-utils) already ships this env var as the
        // official escape hatch: it skips elicitation entirely and falls
        // back to a two-step preview + confirmToken flow instead. Scoped to
        // this one server via its own `environment`, not a global env var,
        // so other MCP servers still get real confirmation prompts.
        // Tracking: https://github.com/anomalyco/opencode/issues/51856
        // (fix in progress — PR #53608). Safe to remove once that lands.
        "MCP_CONFIRM_ELICITATION": "off"
      }
    },
    "slack": {
      "type": "remote",
      "url": "https://gateway.ai-platform-sandbox.vista.io/gateways/slack/mcp",
      "enabled": false
    }
  },
  "permission": {
    "external_directory": {
      "~/Sites/**": "allow",
      // ~/.agents is a symlink farm into ~/Sites/ericmasiello-skills; permission
      // matching checks the path as given, before resolving symlinks, so this
      // needs its own entry even though its targets already live under ~/Sites.
      "~/.agents/**": "allow",
      // Home-level OpenCode state (e.g. the `plan` agent's scratch files),
      // distinct from ~/.config/opencode below.
      "~/.opencode/**": "allow",
      "~/.local/share/opencode/worktree/**": "allow",
      "~/.config/opencode/**": "allow",
      // Work Laptop only: twg writes each run's output to a freshly randomized
      // folder under this machine's TMPDIR, so this hash won't resolve on other machines.
      "/var/folders/08/btbwrfxn3tl4vsqsvv2z46j00000gp/T/twg/**": "allow",
      "/private/var/folders/08/btbwrfxn3tl4vsqsvv2z46j00000gp/T/twg/**": "allow"
    },
    "edit": {
      "~/Sites/**": "allow",
      "~/.agents/**": "allow",
      "~/.opencode/**": "allow",
      "~/.local/share/opencode/worktree/**": "allow",
      "~/.config/opencode/**": "allow"
    }
  }
}
