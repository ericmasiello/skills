{
  "$schema": "https://opencode.ai/config.json",
  // Project-local override: the global config (opencode/opencode.json,
  // symlinked to ~/.config/opencode/opencode.json) keeps skylight disabled
  // by default for every project on this machine. This repo is where the
  // Skylight-dependent skills (ixl-daily-checkin, ixl-weekly-checkin,
  // skylight-homework, skylight-spelling-lessons) actually live, so it's
  // the one place that needs the server turned on. A project config has
  // higher precedence than global and replaces the entire named server
  // object, so this repeats skylight's full definition rather than just
  // flipping a flag.
  "mcp": {
    "servers": {
      "skylight": {
        // The hosted Skylight server on the Synology NAS; see the global
        // config's skylight entry for why it needs no local credentials.
        "type": "remote",
        "url": "https://skylight.tail1057f2.ts.net/mcp"
      }
    }
  }
}
