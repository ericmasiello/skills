# Copy to .env (in this directory) and fill in. Never commit the real .env.
# Shared by every skill that imports ixl-client.ts (currently
# ixl-weekly-checkin and ixl-daily-checkin) — one IXL parent-account login,
# one place to update it. login() in ixl-client.ts logs in fresh every run
# with these (no browser, no saved session file).

# login account
IXL_EMAIL=
# login password
IXL_PASSWORD=

# The "secret word" prompt on the post-login "Who are you? -> Parent" modal —
# a separate passphrase from IXL_PASSWORD, not optional if the other two are set.
IXL_PARENT_PASSWORD=
