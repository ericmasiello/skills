# Copy to .env and fill in. See SETUP.md steps 3-4. Never commit the real .env.

# IXL parent-account login — used only by SKILL.md's self-heal re-login path
# when the saved Playwright session (ixl-auth.local.json) has expired. Leave
# all three blank to disable self-heal: an expired session then stops with an
# actionable message instead of retrying blindly.

# login account
IXL_EMAIL=
# login password
IXL_PASSWORD=

# The "secret word" prompt on the post-login "Who are you? -> Parent" modal —
# a separate passphrase from IXL_PASSWORD, not optional if the other two are set.
IXL_PARENT_PASSWORD=

# Path to a Google service-account JSON key file. The file itself must live
# OUTSIDE this repo (e.g. ~/.secrets/) — only its path goes here.
GOOGLE_SHEETS_CREDENTIALS=

# Optional — update-weekly-log.ts falls back to config.local.json's "sheetId"
# when this is unset.
SHEET_ID=
