# Copy to .env and fill in. See SETUP.md steps 2-3. Never commit the real .env.

# IXL parent-account login — collect-weekly-data.ts and validate-against-sheet.ts
# log in fresh every run with these (no browser, no saved session file). All
# three are required; see ixl-client.ts for the login flow itself.

# login account
IXL_EMAIL=
# login password
IXL_PASSWORD=

# The "secret word" prompt on the post-login "Who are you? -> Parent" modal —
# a separate passphrase from IXL_PASSWORD, not optional if the other two are set.
IXL_PARENT_PASSWORD=

# Path to a Google service-account JSON key file. The file itself must live
# OUTSIDE this repo (e.g. ~/.secrets/) — only its path goes here.
GOOGLE_SHEETS_CREDENTIALS=

# Optional — update-weekly-log.ts falls back to config.local.json's "sheetId"
# when this is unset.
SHEET_ID=
