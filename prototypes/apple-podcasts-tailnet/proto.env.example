# Copy to proto.env (gitignored) and fill in. None of this is a secret, but
# real hostnames and the tailnet name stay out of git. The auth key never goes
# here: `./proto.sh authkey` sends it straight to the NAS from a hidden prompt.

# Your DSM account over SSH, the way you reach the NAS today (LAN address or an
# ~/.ssh/config alias). The NAS host isn't on the tailnet yet.
NAS=you@nas-lan-address

# The prototype's tailnet machine name. Keep it dull: its certificate lands in
# public Certificate Transparency logs.
TS_HOSTNAME=machine-name

# Where the feed is served: <TS_HOSTNAME>.<tailnet>.ts.net
FEED_HOST=machine-name.tailnet-name.ts.net

# The folder nginx mounts read-only. If nas-checks A fails (UID 101 can't read
# the share root), use a chmod 755 subfolder such as /volume1/podcast/public.
PODCAST_DIR=/volume1/podcast
